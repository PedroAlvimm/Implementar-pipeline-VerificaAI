APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
VERIFICAAI_API_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/verificaai.sqlite3
ARTIFACTS_DIR=./data/artifacts
PROVIDER_MODE=fake
OPENAI_API_KEY=
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=
HF_TOKEN=
LOG_LEVEL=INFO

# Modelo linguístico auxiliar local (download inicial aproximado: 436 MB)
RISK_MODEL_MODE=bertimbau
BERTIMBAU_CACHE_DIR=./data/models/bertimbau-v4
BERTIMBAU_MAX_INPUT_TOKENS=512

# Limites seguros da PoC
MAX_CONCURRENT_ANALYSES=2
MAX_QUEUED_JOBS=10
ANALYSIS_TIMEOUT_SECONDS=300
MAX_LLM_CALLS=20
MAX_LLM_TOKENS=100000
MAX_ARTIFACT_BYTES_PER_ANALYSIS=26214400
